rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function used across rules
    function isSignedIn() {
      return request.auth != null;
    }

    // ==========================================
    // EXISTING APP RULES (Untouched)
    // ==========================================

    // users/{uid} — public profile, only owner can write
    match /users/{uid} {
      allow read: if true; // public profiles
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (
        request.auth.uid == uid ||
        // allow follow/unfollow to mutate only followers array of another user
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']))
      );
      allow delete: if false;
    }

    // notes/{noteId} — private personal notes, owner only
    match /notes/{noteId} {
      allow read, update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // posts/{postId} — public published blog posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        // allow any signed-in user to like/unlike and increment views
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likeCount', 'views'])
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // activity/{id} — activity log, owner-created, publicly readable for profile pages
    match /activity/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ==========================================
    // NEW REDDIT APP RULES
    // ==========================================

    // communities/{communityId} — subreddits
    match /communities/{communityId} {
      allow read: if true;
      // Allow signed in users to create communities and update member lists
      allow write: if isSignedIn();
    }

    // reddit_posts/{postId} — posts inside communities
    match /reddit_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        // allow any signed-in user to upvote/downvote and increment comment counts
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'upvotes', 'downvotes', 'commentCount'])
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // comments/{commentId} — nested comments on reddit posts
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        // allow any signed-in user to upvote/downvote comments
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'upvotes', 'downvotes'])
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }
    
    // ==========================================
    // CUSTOM LIBRARIES RULES
    // ==========================================
    
    match /libraries/{libraryId} {
      // Allow creation only if the user sets their own UID
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      
      // Allow read if the library is public, OR if the requester is the owner
      allow read: if resource.data.isPublic == true || (isSignedIn() && resource.data.uid == request.auth.uid);
      
      // Only the owner can rename, change visibility, or delete
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Nested rules for posts saved inside a specific library
      match /posts/{savedPostId} {
        // Read allowed if parent library is public OR owned by the requester
        allow read: if get(/databases/$(database)/documents/libraries/$(libraryId)).data.isPublic == true || 
                       (isSignedIn() && get(/databases/$(database)/documents/libraries/$(libraryId)).data.uid == request.auth.uid);
        
        // Only owner can save or remove posts
        allow write: if isSignedIn() && get(/databases/$(database)/documents/libraries/$(libraryId)).data.uid == request.auth.uid;
      }
    }

  }
}